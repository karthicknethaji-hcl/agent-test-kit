{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-test-kit/schema/test-cases.json",
  "title": "Agent Test Kit — test-cases.json",
  "type": "object",
  "required": ["agentName", "schemaVersion", "testCases"],
  "properties": {
    "agentName": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "string" },
    "sourceDoc": { "type": "string" },
    "note": { "type": "string" },
    "coverage": {
      "type": "object",
      "properties": {
        "inputs": { "enum": ["spec", "code", "both"] },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "summary"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "summary": { "type": "string" },
              "source": { "enum": ["both", "spec-only", "code-only"] },
              "specRef": { "type": "string" },
              "codeRef": { "type": "string" },
              "gapNote": { "type": "string" },
              "variantsNotApplicable": {
                "type": "object",
                "propertyNames": { "enum": ["happy", "negative", "boundary"] },
                "additionalProperties": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "uncovered": { "type": "object", "additionalProperties": { "type": "string" } },
        "independentPass": {
          "type": "object",
          "properties": {
            "reviewer": { "type": "string" },
            "date": { "type": "string" },
            "extraRequirements": {
              "type": "array",
              "items": { "type": "object", "required": ["summary"], "properties": { "summary": { "type": "string" }, "ref": { "type": "string" } } }
            }
          }
        },
        "minRequirementCoverage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "certWaivers": {
      "type": "object",
      "propertyNames": {
        "enum": ["groundedness", "hallucination", "accuracy", "adversarial", "tone", "consistency", "format", "bias", "safety", "robustness", "privacy", "completeness"]
      },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "testCases": {
      "type": "array",
      "items": { "$ref": "#/definitions/testCase" }
    }
  },
  "definitions": {
    "testCase": {
      "type": "object",
      "required": ["testId", "category", "rubric", "v1Scope", "executionMode"],
      "properties": {
        "testId": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "rubric": { "type": "string", "minLength": 1 },
        "v1Scope": { "type": "boolean" },
        "executionMode": {
          "type": "string",
          "enum": ["single-turn", "multi-turn", "dual-conversation", "background-scan", "repeat-n"]
        },
        "covers": { "type": "array", "items": { "type": "string" } },
        "variant": { "enum": ["happy", "negative", "boundary"] },
        "expectedBehaviorNote": { "type": "string" },
        "failureModeNote": { "type": "string" },
        "judgeContext": { "type": "object" },
        "probe": {},
        "setup": { "type": "array" },
        "conversationA": {
          "type": "object",
          "properties": { "setup": { "type": "array" }, "probe": {} }
        },
        "conversationB": {
          "type": "object",
          "properties": { "setup": { "type": "array" }, "probe": {} }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "executionMode": { "const": "single-turn" } } },
          "then": { "required": ["probe"] }
        },
        {
          "if": { "properties": { "executionMode": { "const": "multi-turn" } } },
          "then": { "required": ["probe"] }
        },
        {
          "if": { "properties": { "executionMode": { "const": "dual-conversation" } } },
          "then": { "required": ["conversationA", "conversationB"] }
        }
      ]
    }
  }
}
